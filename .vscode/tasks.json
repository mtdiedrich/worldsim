{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Worldsim: Start Server",
            "type": "shell",
            "command": "python.exe",
            "args": ["-m", "worldsim.cli"],
            "cwd": "${workspaceFolder}",
            "presentation": {
                "reveal": "always",
                "panel": "new"
            },
            "isBackground": true,
            "problemMatcher": {
                "pattern": {
                    "regexp": "^.*$",
                    "file": 1,
                    "location": 2,
                    "message": 3
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "^.*Uvicorn running on.*",
                    "endsPattern": "^.*Shutdown complete.*"
                }
            },
            "runOptions": {
                "runOn": "folderOpen"
            }
        },
        {
            "label": "Worldsim: Run Tests",
            "type": "shell",
            "command": "python.exe",
            "args": ["-m", "pytest", "tests/", "-v"],
            "cwd": "${workspaceFolder}",
            "presentation": {
                "reveal": "always",
                "panel": "new"
            },
            "problemMatcher": {
                "pattern": {
                    "regexp": "^(.+):(\\d+):(\\d+): (.+)$",
                    "file": 1,
                    "line": 2,
                    "column": 3,
                    "message": 4
                }
            }
        }
    ]
}
